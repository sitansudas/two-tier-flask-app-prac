post {
    success {
        emailext(
            subject: "Build Successful",
            body: "Good news! Your build was successful.",
            to: "sitansudas255@gmail.com"
        )
    }

    failure {
        emailext(
            subject: "Build Failed",
            body: "Bad news! Your build has failed.",
            to: "sitansudas255@gmail.com"
        )
    }
}
